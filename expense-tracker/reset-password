import app
from werkzeug.security import generate_password_hash
from database.db import get_db

email = "atulv.11239@gmail.com"
new_password = input("Enter your new admin password: ")

if len(new_password) < 12:
    raise SystemExit("ERROR: Password must be at least 12 characters.")

conn = get_db()

try:
    user = conn.execute(
        "SELECT user_id FROM users WHERE lower(email) = lower(?)",
        (email,)
    ).fetchone()

    password_hash = generate_password_hash(new_password)

    if user:
        conn.execute(
            """UPDATE users
               SET password = ?, is_approved = 1, is_rejected = 0,
                   is_terminated = 0, role = ?, job_role = ?
               WHERE user_id = ?""",
            (password_hash, "Admin", "Admin", user["user_id"])
        )
        print("SUCCESS: Existing admin password reset.")
    else:
        conn.execute(
            """INSERT INTO users
               (email, password, full_name, is_approved, is_rejected,
                is_terminated, role, job_role, requested_role)
               VALUES (?, ?, ?, 1, 0, 0, ?, ?, ?)""",
            (email, password_hash, "Atul Rai", "Admin", "Admin", "Admin")
        )
        print("SUCCESS: New admin account created.")

    conn.commit()
finally:
    conn.close()
'
