# Copy this file to .env for local development. Never commit .env.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
FLEETFLOW_PUBLIC_URL=http://127.0.0.1:5001
FLASK_HOST=127.0.0.1
PORT=5001

# Optional; defaults to expense-tracker/tms.db. Use a separate path for tests.
DATABASE_PATH=tms.db

# Optional bootstrap administrator for a NEW development database only.
# Use a unique email and a strong password of at least 12 characters.
# FLEETFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# FLEETFLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional SMTP password-reset delivery
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=FleetFlow <no-reply@example.com>
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional root administrator email used by access rules
# FLEETFLOW_SUPER_ADMIN_EMAIL=admin@example.com

# Optional FleetFlow LangGraph assistant intent classification (read-only fallback works without a key)
# GEMINI_API_KEY=replace-with-your-own-key
# FLEETFLOW_AI_MODEL=gemini-2.5-flash

# Optional LangSmith tracing/observability. Keep tracing off unless configured.
# Set LANGSMITH_API_KEY in your private local .env; never commit the real key.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=replace-with-your-own-langsmith-key
# LANGSMITH_PROJECT=fleetflow-assistant
