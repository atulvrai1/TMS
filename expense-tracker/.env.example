# Copy this file to .env and replace the placeholder values.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-this-with-a-random-secret
FLEETFLOW_SUPER_ADMIN_EMAIL=admin@example.com
DATABASE_PATH=tms.db

# Optional email delivery for password recovery. Without SMTP_HOST, reset links
# are written to expense-tracker/instance/email_mock.log with restrictive permissions.
# Set FLEETFLOW_PUBLIC_URL to the externally reachable app origin in production.
FLEETFLOW_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
