# Copy this file to .env.docker. Never commit real secrets.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-unique-random-secret
FLEETFLOW_PUBLIC_URL=http://127.0.0.1:5001
PORT=5001

# Optional LangSmith observability for LangGraph runs.
# Keep tracing disabled unless you have configured a private API key.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=fleetflow-assistant
# LANGSMITH_API_KEY=replace-with-your-own-langsmith-key

# Optional Gemini model configuration.
# GEMINI_API_KEY=
# FLEETFLOW_AI_MODEL=gemini-2.5-flash

# Optional SMTP settings for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Msg07 compliance expiry SMS. Get API URL/key and payload shape from your Msg07 account docs.
# Keep real credentials only in private .env.docker.
MSG07_API_URL=
MSG07_API_KEY=
# Default authentication is Authorization: Bearer <key>.
# If your workspace uses X-API-Key, set MSG07_AUTH_HEADER=X-API-Key and MSG07_AUTH_SCHEME=
MSG07_AUTH_HEADER=Authorization
MSG07_AUTH_SCHEME=Bearer
# Default payload is {"to":"{{mobile}}","message":"{{message}}"}.
# Change this JSON to match the exact Msg07 API schema if needed.
MSG07_PAYLOAD_TEMPLATE={"to":"{{mobile}}","message":"{{message}}"}
MSG07_MESSAGE_TEMPLATE=FleetFlow alert: {document} for {vehicle}. Please check and renew the compliance document.
COMPLIANCE_SMS_CHECK_INTERVAL_SECONDS=86400
