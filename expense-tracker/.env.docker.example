# Copy this file to .env.docker. Never commit real secrets.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-unique-random-secret
FLEETFLOW_PUBLIC_URL=http://127.0.0.1:5001
PORT=5001

# Optional LangSmith observability for LangGraph runs.
# Keep tracing disabled unless you have configured a private API key.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=fleetflow-assistant
# LANGSMITH_API_KEY=replace-with-your-own-langsmith-key

# Optional Gemini model configuration.
# GEMINI_API_KEY=
# FLEETFLOW_AI_MODEL=gemini-2.5-flash

# Optional SMTP settings for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Fast2SMS compliance expiry SMS (keep real credentials only in private .env.docker).
# Get the API key from Fast2SMS; domestic DLT messages need approved values from your provider/operator.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_ENTITY_ID=
FAST2SMS_TEMPLATE_ID=
# Must match the DLT-approved content template. Keep these two placeholders.
FAST2SMS_MESSAGE_TEMPLATE=FleetFlow alert: {document} for {vehicle}. Please check and renew the compliance document.
# Worker checks once per day (86400 seconds). Minimum supported interval is 3600 seconds.
COMPLIANCE_SMS_CHECK_INTERVAL_SECONDS=86400
