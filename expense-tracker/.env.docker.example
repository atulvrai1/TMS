# Copy this file to .env.docker. Never commit real secrets.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-unique-random-secret
FLEETFLOW_PUBLIC_URL=http://127.0.0.1:5001
PORT=5001

# Optional LangSmith observability for LangGraph runs.
# Keep tracing disabled unless you have configured a private API key.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=fleetflow-assistant
# LANGSMITH_API_KEY=replace-with-your-own-langsmith-key

# Optional Gemini model configuration.
# GEMINI_API_KEY=
# FLEETFLOW_AI_MODEL=gemini-2.5-flash

# Optional SMTP settings for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# My SMS Gateway compliance expiry SMS. Create an account and pair an Android phone/SIM.
MY_SMS_GATEWAY_API_URL=https://api.mysmsgateway.com/v1/sms/send
MY_SMS_GATEWAY_API_KEY=
MY_SMS_GATEWAY_DEVICE_ID=
MY_SMS_GATEWAY_SIM=1
MY_SMS_GATEWAY_MESSAGE_TYPE=transactional
MY_SMS_GATEWAY_MESSAGE_TEMPLATE=FleetFlow alert: {document} for {vehicle}. Please check and renew the compliance document.
COMPLIANCE_SMS_CHECK_INTERVAL_SECONDS=86400
